// Tailscale ACL Policy - Gérée par OpenTofu (01-core-network)
{
	// Tag Owners (pour les serveurs et nœuds automatisés)
	"tagOwners": {
		"tag:server": ["autogroup:admin"],
		"tag:exit-node": ["autogroup:admin"],
		"tag:k8s": ["autogroup:admin"],
		"tag:vps": ["autogroup:admin"],
		"tag:nixos": ["autogroup:admin"]
	},

	// Contrôle d'accès (ACLs)
	"acls": [
		// Les administrateurs et membres ont accès aux ressources
		{
			"action": "accept",
			"src": ["autogroup:admin", "autogroup:member"],
			"dst": ["*:*"]
		}
	],

	// Directives SSH
	"ssh": [
		{
			"action": "check",
			"src": ["autogroup:admin", "autogroup:member"],
			"dst": ["tag:server", "tag:vps", "tag:nixos", "autogroup:self"],
			"users": ["root", "flebel"],
			"checkPeriod": "12h"
		}
	]
}
